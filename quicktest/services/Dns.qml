pragma Singleton
import Quickshell
import Quickshell.Io
import QtQuick

// ── Dns ───────────────────────────────────────────────────────────────────────
// Which resolvers this machine uses, and changing them.
//
// ── Why this shells out when the rest of the shell refuses to ─────────────────
// NetStats reads /proc and /sys because it only ever LOOKS. This one writes, and
// there is no read-only file to write to: /etc/resolv.conf is generated by
// NetworkManager and rewritten on every reconnect, so editing it directly buys you
// a setting that silently reverts the next time the link comes up. The setting lives
// in NM's connection profile, and nmcli is the supported way to reach it. D-Bus
// directly would mean hand-rolling the Settings.Connection Update2 call and its
// a{sa{sv}} payload, which is more surface for the same result.
//
// ── The authorisation problem, stated up front ───────────────────────────────
// This machine's Wi-Fi profile is a SYSTEM connection — `connection.permissions` is
// empty, so it isn't owned by a user. Changing it therefore needs polkit's
// `settings.modify.system`, which is `auth_admin_keep`: an admin password prompt,
// every time. A password prompt needs a polkit AGENT to draw it, and an agent is a
// separate process from polkitd. Without one, nmcli doesn't hang and doesn't ask —
// it fails immediately with "Not authorized", which looks exactly like a bug.
//
// So `authError` is a first-class state here rather than an afterthought, and the UI
// says what to install. This is the one control in the shell that can be correctly
// built, correctly wired, and still do nothing because of something outside it.
//
// ── Applying costs you the link, briefly ─────────────────────────────────────
// `nmcli con mod` writes the profile but does NOT touch the running connection —
// resolv.conf keeps the old servers until the link is re-established. So apply() is
// mod-then-up, and `up` disconnects and reconnects: a second or two offline. That's
// not a bug to hide, it's the cost of the operation, and the UI warns before it.
// ─────────────────────────────────────────────────────────────────────────────
Singleton {
    id: root

    // ── The known-good presets ────────────────────────────────────────────────
    // Each carries two resolvers per family: a single nameserver is a single point of
    // failure, and NM will happily accept one and leave you with no fallback.
    //
    // ── Why every preset carries IPv6 too ─────────────────────────────────────
    // This is not completeness for its own sake. This machine's DHCP hands out THREE
    // IPv6 nameservers alongside two IPv4 ones (measured — see NetStats). Set only
    // ipv4.dns and NM leaves the IPv6 ones untouched, so resolv.conf still lists the
    // ISP's resolvers and glibc is free to prefer them. The panel would report
    // "Cloudflare", the traffic would go to the router, and nothing would look wrong.
    // A DNS switch that only covers one family is worse than none, because it lies.
    readonly property var presets: [
        { id: "auto",       name: "Automatic",  detail: "From the router (DHCP)",
          v4: [], v6: [] },
        { id: "cloudflare", name: "Cloudflare", detail: "1.1.1.1",
          v4: ["1.1.1.1", "1.0.0.1"],
          v6: ["2606:4700:4700::1111", "2606:4700:4700::1001"] },
        { id: "quad9",      name: "Quad9",      detail: "9.9.9.9 · blocks known-malicious",
          v4: ["9.9.9.9", "149.112.112.112"],
          v6: ["2620:fe::fe", "2620:fe::9"] },
        { id: "google",     name: "Google",     detail: "8.8.8.8",
          v4: ["8.8.8.8", "8.8.4.4"],
          v6: ["2001:4860:4860::8888", "2001:4860:4860::8844"] }
    ]

    function presetFor(id) {
        return root.presets.find(p => p.id === id) ?? root.presets[0]
    }

    // ── State ─────────────────────────────────────────────────────────────────
    readonly property string uuid: root._uuid
    readonly property string conName: root._conName
    property string _uuid: ""
    property string _conName: ""

    // The profile's CONFIGURED servers — not the ones in use. Empty means "whatever
    // DHCP said", which is what NetStats.dns is actually reporting.
    readonly property var configured:   root._configured      // IPv4
    readonly property var configuredV6: root._configuredV6
    readonly property bool ignoreAuto:  root._ignoreAuto
    property var  _configured:   []
    property var  _configuredV6: []
    property bool _ignoreAuto: false

    function _sameList(a, b) {
        if (a.length !== b.length) return false
        for (let i = 0; i < a.length; i++)
            if (a[i].toLowerCase() !== b[i].toLowerCase()) return false
        return true
    }

    // Which preset the current config corresponds to, or "custom".
    // Matches on BOTH families: a profile with Cloudflare's IPv4 and the router's IPv6
    // is not "Cloudflare", and calling it that is the exact lie the v6 presets exist to
    // prevent. It's "custom", and the panel says so.
    readonly property string activeId: {
        if (!root._ignoreAuto || root._configured.length === 0) return "auto"
        for (const p of root.presets) {
            if (p.v4.length === 0) continue
            if (root._sameList(p.v4, root._configured)
             && root._sameList(p.v6, root._configuredV6)) return p.id
        }
        return "custom"
    }

    readonly property bool busy: root._busy
    property bool _busy: false

    // "" = fine. Split from a generic error because the fix is completely different:
    // one is "try again", the other is "install a polkit agent".
    readonly property string error: root._error
    readonly property bool authError: root._authError
    property string _error: ""
    property bool _authError: false

    signal applied()

    // ── Reading the profile ───────────────────────────────────────────────────
    function refresh() { activeProc.running = true }

    Component.onCompleted: root.refresh()

    Process {
        id: activeProc
        // The wireless profile specifically. `--active` also lists loopback, and on a
        // docked machine an ethernet profile too; picking the first row would bind this
        // service to whichever NM happened to list first.
        command: ["bash", "-c",
                  "nmcli -t -f UUID,TYPE,NAME connection show --active "
                + "| awk -F: '$2==\"802-11-wireless\"{print $1\"\\t\"$3; exit}'"]
        stdout: StdioCollector {
            onStreamFinished: {
                const parts = text.trim().split("\t")
                root._uuid    = parts[0] ?? ""
                root._conName = parts[1] ?? ""
            }
        }
        onExited: function(code) {
            if (root._uuid !== "") readProc.running = true
        }
    }

    Process {
        id: readProc
        command: ["nmcli", "-t", "-f",
                  "ipv4.dns,ipv4.ignore-auto-dns,ipv6.dns,ipv6.ignore-auto-dns",
                  "connection", "show", root._uuid]
        stdout: StdioCollector {
            onStreamFinished: {
                // Split on the FIRST colon only. The key never contains one; an IPv6
                // value is almost entirely colons. And they arrive unescaped — nmcli's
                // terse mode is documented as escaping ':' in values, but it demonstrably
                // does not for these fields (verified against real output:
                // `IP6.ADDRESS[1]:2a12:26c0:3101:...` comes through raw). An unescape
                // pass here would be cargo cult.
                let v4 = [], v6 = [], ignore = false
                const list = s => s === "" ? []
                                : s.split(",").map(x => x.trim()).filter(x => x !== "")
                for (const line of text.split("\n")) {
                    const i = line.indexOf(":")
                    if (i < 0) continue
                    const key = line.substring(0, i).trim()
                    const val = line.substring(i + 1).trim()
                    switch (key) {
                        case "ipv4.dns":             v4 = list(val); break
                        case "ipv6.dns":             v6 = list(val); break
                        case "ipv4.ignore-auto-dns": ignore = val === "yes"; break
                    }
                }
                root._configured   = v4
                root._configuredV6 = v6
                root._ignoreAuto   = ignore
            }
        }
    }

    // ── Writing it ────────────────────────────────────────────────────────────
    property var _pendingV4: []
    property var _pendingV6: []

    function applyPreset(id) {
        const p = root.presetFor(id)
        root.apply(p.v4, p.v6)
    }

    // Both empty restores DHCP.
    function apply(v4, v6) {
        if (root._busy || root._uuid === "") return
        root._error = ""
        root._authError = false
        root._pendingV4 = v4
        root._pendingV6 = v6 ?? []
        root._busy = true
        modProc.running = true
    }

    // Space-separated for nmcli's value, and ignore-auto-dns follows automatically:
    // setting servers without it APPENDS yours to the router's rather than replacing
    // them — you'd end up querying both, which looks like the change didn't take.
    readonly property string _pendingArgV4: root._pendingV4.join(" ")
    readonly property string _pendingArgV6: root._pendingV6.join(" ")

    Process {
        id: modProc
        // Both families in one modify, so a failure can't leave IPv4 switched and IPv6
        // on the router's servers — a half-applied state that resolves through the ISP
        // while the UI claims otherwise.
        command: ["nmcli", "connection", "modify", root._uuid,
                  "ipv4.dns", root._pendingArgV4,
                  "ipv4.ignore-auto-dns", root._pendingV4.length > 0 ? "yes" : "no",
                  "ipv6.dns", root._pendingArgV6,
                  "ipv6.ignore-auto-dns", root._pendingV6.length > 0 ? "yes" : "no"]
        stderr: StdioCollector { id: modErr }
        onExited: function(code) {
            if (code !== 0) { root._fail(modErr.text); return }
            upProc.running = true
        }
    }

    // mod writes the profile; up is what makes resolv.conf change. Without this the
    // setting is real but invisible until the next reconnect.
    Process {
        id: upProc
        command: ["nmcli", "connection", "up", root._uuid]
        stderr: StdioCollector { id: upErr }
        onExited: function(code) {
            root._busy = false
            if (code !== 0) { root._fail(upErr.text); return }
            root.refresh()
            root.applied()
        }
    }

    function _fail(raw) {
        root._busy = false
        const msg = (raw ?? "").trim()
        // polkit's refusal is the expected failure on this machine, not an edge case —
        // so it's detected and named rather than dumped as a wall of nmcli stderr.
        root._authError = /not authorized|not permitted|permission denied/i.test(msg)
        root._error = root._authError
            ? "Not authorised to change this connection."
            : (msg === "" ? "Failed to apply DNS settings." : msg)
    }
}
