pragma Singleton
import Quickshell
import Quickshell.Io
import QtQuick
import "../config"
import "launcher.js" as Logic

// ── Emoji ─────────────────────────────────────────────────────────────────────
// The launcher's `:` picker: a name search over services/emoji.json (generated by
// scripts/gen-emoji.py, so nothing here knows the Unicode list), and the few you reach for
// most. Enter COPIES the emoji (Clipboard.copyText) — the shell has no business typing into
// whichever window happens to have focus.
//
// ── Lazy, because it is 78 KB nobody opens most days ──────────────────────────
// The list is read the first time `:` is up (`wanted`, set by the panel) and kept; the
// shell pays nothing until then. The ranking is launcher.js `searchEmoji` (tested).
//
// ── A missing font DISABLES the mode with a reason (the blocker() contract) ───
// Without an emoji font every row would be an empty square. `blocker()` says so and the
// launcher shows that instead of a list of blanks. `noto-fonts-emoji` is in
// scripts/install-dependencies.sh.
// ─────────────────────────────────────────────────────────────────────────────
Singleton {
    id: root

    // The panel raises this while `:` is the mode; the file is read on the first raise.
    property bool wanted: false

    property var list: []
    readonly property bool ready: root.list.length > 0

    // Qt's own list of installed families, read once (fonts do not come and go mid-session).
    readonly property bool fontFound: Qt.fontFamilies().some(f => /emoji/i.test(f))
    function blocker() {
        return root.fontFound ? "" : "No emoji font installed (noto-fonts-emoji)"
    }

    FileView {
        id: file
        path: root.wanted || root.ready ? Quickshell.shellPath("services/emoji.json") : ""
        onLoaded: {
            try { root.list = JSON.parse(file.text()) }
            catch (e) { console.warn("Emoji: services/emoji.json is not valid JSON —", e) }
        }
    }

    // Most recent first. Characters only: it never records what you searched for.
    JsonStore {
        id: store
        path: Quickshell.statePath("emoji-recent.json")
        defaults: []
    }
    readonly property int recentCap: 24
    readonly property var recents:
        (Array.isArray(store.value) ? store.value : []).filter(c => typeof c === "string").slice(0, root.recentCap)

    // Launcher rows for `query` (recents and the top of the list for an empty one).
    function search(query, limit) {
        if (!root.ready || root.blocker() !== "") return []
        return Logic.searchEmoji(root.list, query, root.recents, limit).map(h => {
            const e = root.list[h.i]
            return { kind: "emoji", id: "emoji:" + e[0], name: e[1], ranges: h.ranges,
                     generic: e[2], char: e[0] }
        })
    }

    function pick(row) {
        if (!row || !row.char) return
        Clipboard.copyText(row.char)
        store.value = Logic.pushRecent(root.recents, row.char, root.recentCap)
    }

    function clearRecents() { store.value = [] }
}
