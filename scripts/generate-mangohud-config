#!/usr/bin/env python3
"""Generate a MangoHud config from the live pywal palette.

    generate-mangohud-config [--preset full|compact|fps|off]

So the in-game FPS/frametime overlay follows the wallpaper like every other themed
app — kitty, qt6ct, GTK, Steam. Called by scripts/reload-theme.sh after every
wallpaper / colour-scheme change (no argument = refresh colours only), and by the
shell's Gaming panel with --preset to switch how much the overlay shows.

── Surgical, like generate-qt6ct-colors ──────────────────────────────────────
MangoHud.conf is a hand-tunable file: position, the toggle keybind, font size, the
metrics you want are all yours. This script owns exactly two marker regions and
rewrites nothing else, line for line:

    ### quicktest:colors …        the *_color= lines, from the palette
    ### quicktest:preset=<name> …  which metrics are shown

Everything outside both regions — including anything you add above them — is kept
byte-for-byte. Delete a region's markers and this script stops touching it.

── MangoHud wants RRGGBB, no '#' ─────────────────────────────────────────────
`gpu_color=88C0D0`. A leading '#' is silently ignored by some builds and breaks
others, so it is stripped here.

── Reloading a running game ──────────────────────────────────────────────────
MangoHud does not watch the file. A game already running keeps its old overlay
until you press the reload keybind (default Shift_L+F4) or relaunch it. Setting the
overlay before launch is the normal path.
"""

import os
import sys

CACHE = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
WAL = os.path.join(CACHE, "wal", "colors.json")
CONF = os.path.join(CONFIG, "MangoHud", "MangoHud.conf")

COLORS_BEGIN = "### quicktest:colors — generated by generate-mangohud-config, edits overwritten"
COLORS_END = "### end quicktest:colors"
PRESET_BEGIN = "### quicktest:preset=%s — generated by generate-mangohud-config, edits overwritten"
PRESET_END = "### end quicktest:preset"

PRESETS = ("full", "compact", "fps", "off")
DEFAULT_PRESET = "full"

# ── The bits a person owns — only written when the file does not exist yet ─────
HEADER = """# MangoHud config — managed in part by quicktest (see the marked regions).
# Full option list: https://github.com/flightlessmango/MangoHud
# Toggle the overlay in-game with the keybind below; reload this file with Shift_L+F4.

toggle_hud=Shift_R+F12
toggle_hud_position=Shift_R+F11
reload_cfg=Shift_L+F4

position=top-left
horizontal=0
table_columns=3
font_size=20
background_alpha=0.4
round_corners=8
"""

PRESET_BODIES = {
    "full": """fps
frametime=1
frame_timing=1
gpu_stats
gpu_load_change
gpu_temp
gpu_core_clock
gpu_power
gpu_mem_clock
vram
cpu_stats
cpu_load_change
cpu_temp
ram
swap
procmem
""",
    "compact": """fps
frame_timing=1
gpu_stats
gpu_temp
cpu_stats
cpu_temp
vram
ram
""",
    "fps": """fps
frame_timing=1
""",
    "off": """no_display=1
""",
}


def _rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def _bare(h):
    """RRGGBB, no '#'. See the header."""
    return "%02x%02x%02x" % _rgb(h)


def colors_region(wal):
    c = wal["colors"]
    fg = wal["special"]["foreground"]
    # Roles chosen to read at a glance: each metric a distinct hue, text the
    # foreground, the engine/wine badge the accent.
    mapping = {
        "text_color": fg,
        "gpu_color": c["color1"],
        "cpu_color": c["color4"],
        "vram_color": c["color5"],
        "ram_color": c["color2"],
        "engine_color": c["color6"],
        "io_color": c["color3"],
        "frametime_color": c["color2"],
        "wine_color": c["color6"],
        "fps_color_low": c["color1"],
        "fps_color_med": c["color3"],
        "fps_color_high": c["color2"],
        "battery_color": c["color5"],
        "media_player_color": c["color4"],
        "network_color": c["color4"],
    }
    lines = [COLORS_BEGIN]
    lines += ["%s=%s" % (k, _bare(v)) for k, v in mapping.items()]
    lines.append(COLORS_END)
    return lines


def preset_region(name):
    body = PRESET_BODIES[name].strip("\n").split("\n")
    return [PRESET_BEGIN % name] + body + [PRESET_END]


def current_preset(lines):
    for ln in lines:
        s = ln.strip()
        if s.startswith("### quicktest:preset="):
            return s.split("=", 1)[1].split(" ", 1)[0]
    return None


def splice(lines, begin_prefix, end_marker, new_block):
    """Replace the first begin_prefix…end_marker region with new_block.

    Returns (lines, found). If not found, caller decides where to append.
    """
    out, i, found = [], 0, False
    while i < len(lines):
        if not found and lines[i].strip().startswith(begin_prefix):
            # skip through the end marker
            while i < len(lines) and lines[i].strip() != end_marker:
                i += 1
            i += 1  # past the end marker itself
            out.extend(new_block)
            found = True
            continue
        out.append(lines[i])
        i += 1
    return out, found


def main():
    preset = None
    args = sys.argv[1:]
    if args:
        if args[0] == "--preset" and len(args) == 2 and args[1] in PRESETS:
            preset = args[1]
        else:
            sys.stderr.write(__doc__.split("\n\n")[0] + "\n")
            sys.stderr.write("usage: generate-mangohud-config [--preset %s]\n"
                             % "|".join(PRESETS))
            return 2

    try:
        import json
        wal = json.load(open(WAL))
    except (OSError, ValueError) as e:
        sys.stderr.write("generate-mangohud-config: no palette (%s)\n" % e)
        return 1

    fresh = not os.path.exists(CONF)
    if fresh:
        lines = HEADER.rstrip("\n").split("\n") + ["", ""]
    else:
        lines = open(CONF).read().split("\n")

    # Colours: always refreshed.
    lines, found = splice(lines, "### quicktest:colors", COLORS_END, colors_region(wal))
    if not found:
        if lines and lines[-1] != "":
            lines.append("")
        lines.extend(colors_region(wal))

    # Preset: only touched when asked, or seeded on a fresh file.
    want = preset or current_preset(lines) or (DEFAULT_PRESET if fresh else None)
    if want:
        lines, found = splice(lines, "### quicktest:preset=", PRESET_END, preset_region(want))
        if not found:
            if lines and lines[-1] != "":
                lines.append("")
            lines.extend(preset_region(want))

    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        f.write("\n".join(lines).rstrip("\n") + "\n")

    print("MangoHud config written to %s%s"
          % (CONF, "" if not want else " (preset: %s)" % want))
    return 0


if __name__ == "__main__":
    sys.exit(main())
